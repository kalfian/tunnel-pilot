# Secrets & updater signing keys (org policy: never commit)
.env
.env.*
!.env.example
# Tauri updater minisign private key (the PUBLIC key stays in tauri.conf.json).
# Generated as a .key file by `tauri signer generate`; keep it out of git.
*.key
tunnel_pilot_secrets.json
