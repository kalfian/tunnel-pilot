{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tunnel Pilot",
  "version": "2.0.0",
  "identifier": "com.kalfian.tunnelpilot",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Tunnel Pilot",
        "dragDropEnabled": false,
        "width": 860,
        "height": 640,
        "minWidth": 560,
        "minHeight": 480,
        "resizable": true,
        "visible": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUwQTNCRUM3NkQ2MjlCMjAKUldRZ20ySnR4NzZqNFBrUExZc2ZncW80bjBQalVVVFpOdlNEWm5IbFZVMFZ0OHNJSGhYOEZBd3cK",
      "endpoints": [
        "https://github.com/kalfian/tunnel-pilot/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg", "nsis", "appimage", "deb", "rpm"],
    "category": "DeveloperTool",
    "publisher": "Kalfian",
    "copyright": "Copyright © 2026 Kalfian. MIT License.",
    "shortDescription": "SSH local port forwarding manager",
    "longDescription": "Tunnel Pilot manages SSH local port forwards from the system tray — configure once, toggle from the menu bar / tray. Cross-platform (macOS, Windows, Linux).",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
