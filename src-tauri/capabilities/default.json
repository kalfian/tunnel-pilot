{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window. Only the commands in spec/02 §6 are exposed (AGENTS.md §8).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "autostart:default",
    "notification:default",
    "updater:default",
    "dialog:default",
    "clipboard-manager:default"
  ]
}
